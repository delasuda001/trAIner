# Clé Garmin Connect Personal API (serveur uniquement).
# À créer sur https://connect.garmin.com/app/settings/personalApiToken
GARMIN_API_KEY=

# Modèle Claude utilisé pour le coach (via l'abonnement Claude connecté au CLI `claude`).
# Valeurs possibles : sonnet (par défaut, économe), opus, haiku.
CLAUDE_COACH_MODEL=sonnet

# SQLite local (serveur uniquement)
DATABASE_URL=file:./data/run-insights.db
